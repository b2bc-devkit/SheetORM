{
  "name": "@b2bc-devkit/sheetorm",
  "version": "1.2.3",
  "description": "TypeScript ORM for Google Sheets (Google Apps Script runtime)",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "wireit",
    "build:npm": "wireit",
    "lint": "wireit",
    "knip": "wireit",
    "trivy:scan": "wireit",
    "format": "prettier . --write",
    "test": "wireit",
    "login": "clasp login"
  },
  "wireit": {
    "knip": {
      "command": "knip",
      "files": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "examples/**/*.ts",
        "scripts/**/*.mjs",
        "knip.json",
        "package.json",
        "tsconfig.json",
        "tsconfig.gas.json",
        "tsconfig.npm.json",
        "tsconfig.test.json",
        "vite.config.mjs",
        "eslint.config.cjs",
        "jest.config.cjs"
      ],
      "output": []
    },
    "trivy:scan": {
      "command": "npx @b2bc-devkit/trivy-scan fs --config trivy.yaml .",
      "files": [
        "package-lock.json",
        "trivy.yaml"
      ],
      "output": []
    },
    "build": {
      "command": "node scripts/build.mjs",
      "dependencies": [
        "knip",
        "trivy:scan"
      ],
      "files": [
        "src/**/*.ts",
        "scripts/build.mjs",
        "tsconfig.json",
        "tsconfig.gas.json",
        "vite.config.mjs",
        "appsscript.json"
      ],
      "output": [
        "build/**",
        "Code.js"
      ]
    },
    "build:npm": {
      "command": "node scripts/build-npm.mjs",
      "dependencies": [
        "knip",
        "trivy:scan"
      ],
      "files": [
        "src/**/*.ts",
        "scripts/build-npm.mjs",
        "tsconfig.json",
        "tsconfig.npm.json"
      ],
      "output": [
        "dist/npm/**"
      ]
    },
    "lint": {
      "command": "eslint .",
      "files": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "examples/**/*.ts",
        "scripts/**/*.mjs",
        "eslint.config.cjs",
        "package.json"
      ],
      "output": []
    },
    "test": {
      "command": "jest --verbose",
      "files": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "jest.config.cjs",
        "tsconfig.test.json",
        "package.json"
      ],
      "output": []
    }
  },
  "files": [
    "dist/npm/**/*"
  ],
  "main": "./dist/npm/SheetOrm.js",
  "module": "./dist/npm/SheetOrm.js",
  "types": "./dist/npm/SheetOrm.d.ts",
  "exports": {
    ".": {
      "import": "./dist/npm/SheetOrm.js",
      "types": "./dist/npm/SheetOrm.d.ts"
    },
    "./SheetOrm": {
      "import": "./dist/npm/SheetOrm.js",
      "types": "./dist/npm/SheetOrm.d.ts"
    },
    "./core/Record": {
      "import": "./dist/npm/core/Record.js",
      "types": "./dist/npm/core/Record.d.ts"
    },
    "./core/Decorators": {
      "import": "./dist/npm/core/Decorators.js",
      "types": "./dist/npm/core/Decorators.d.ts"
    },
    "./query/Query": {
      "import": "./dist/npm/query/Query.js",
      "types": "./dist/npm/query/Query.d.ts"
    },
    "./index/IndexStore": {
      "import": "./dist/npm/index/IndexStore.js",
      "types": "./dist/npm/index/IndexStore.d.ts"
    },
    "./core/Registry": {
      "import": "./dist/npm/core/Registry.js",
      "types": "./dist/npm/core/Registry.d.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b2bc-devkit/SheetORM.git"
  },
  "homepage": "https://github.com/b2bc-devkit/SheetORM#readme",
  "bugs": {
    "url": "https://github.com/b2bc-devkit/SheetORM/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@b2bc-devkit/gas-class-entrypoints": "^1.0.0",
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.8",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-googleappsscript": "^1.0.5",
    "jest": "^30.3.0",
    "knip": "^6.25.0",
    "prettier": "^3.8.1",
    "terser": "^5.44.1",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "wireit": "^0.14.13"
  }
}
